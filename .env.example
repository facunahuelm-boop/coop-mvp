# Copiá este archivo a .env.local y completá los valores (nunca subas .env.local a git).
# Lo más simple en cada computadora: `vercel env pull .env.local` (trae los valores reales del proyecto en Vercel).
DATABASE_URL=            # conexión con permisos de administración (migraciones)
APP_DATABASE_URL=        # conexión del usuario de la aplicación (app_user, sin permiso de borrar)
AUTH_SECRET=             # secreto para firmar sesiones (cadena larga aleatoria)
NEXT_PUBLIC_DEFAULT_ORG_SLUG=ufama
